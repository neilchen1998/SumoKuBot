{
  "version": 10,

  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "warnings": {
        "dev": false
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-tests",
      "displayName": "Debug + Tests",
      "inherits": "debug",
      "cacheVariables": {
        "PROJECT_BUILD_APPS": "OFF",
        "PROJECT_BUILD_TESTS": "ON",
        "PROJECT_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PROJECT_BUILD_NUMBER": "$env{CI_BUILD_NUMBER}"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmark",
      "inherits": "release",
      "cacheVariables": {
        "PROJECT_BUILD_APPS": "OFF",
        "PROJECT_BUILD_TESTS": "OFF",
        "PROJECT_BUILD_BENCHMARKS": "ON",
        "PROJECT_NATIVE_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "ci-benchmark",
      "displayName": "CI Benchmark",
      "inherits": "benchmark",
      "cacheVariables": {
        "PROJECT_BUILD_NUMBER": "$env{CI_BUILD_NUMBER}",
        "USE_FETCHED_BOOST": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "inherits": "debug-tests",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_C_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base-build",
      "hidden": true
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": "base-build"
    },
    {
      "name": "debug-tests",
      "configurePreset": "debug-tests",
      "inherits": "base-build"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "inherits": "base-build"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "inherits": "base-build",
      "jobs": 4
    },
    {
      "$comment": "Will run benchmarks immediately afterwards",
      "name": "benchmark",
      "configurePreset": "benchmark",
      "inherits": "base-build",
      "targets": [
        "benchmarks"
      ]
    },
    {
      "name": "ci-benchmark",
      "configurePreset": "ci-benchmark",
      "inherits": "base-build",
      "jobs": 4,
      "targets": [
        "benchmarks"
      ]
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "inherits": "base-build"
    }
  ],
  "testPresets": [
    {
      "name": "debug-tests",
      "configurePreset": "debug-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/_build/coverage/coverage-%p.profraw"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "coverage",
      "displayName": "Coverage",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "test",
          "name": "coverage"
        }
      ]
    }
  ]
}
