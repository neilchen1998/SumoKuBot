{
  "version": 10,

  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/_build-${presetName}",
      "warnings": {
        "dev": false
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-tests",
      "displayName": "Debug + Tests",
      "inherits": "debug",
      "cacheVariables": {
        "PROJECT_BUILD_APPS": "OFF",
        "PROJECT_BUILD_TESTS": "ON",
        "PROJECT_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-benchmarks",
      "displayName": "Release + Benchmarks",
      "inherits": "release",
      "cacheVariables": {
        "PROJECT_BUILD_APPS": "OFF",
        "PROJECT_BUILD_TESTS": "OFF",
        "PROJECT_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "inherits": "debug-tests",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_C_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 0
    },
    {
      "name": "debug-tests",
      "configurePreset": "debug-tests",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "$comment": "Will run benchmarks immediately afterwards",
      "name": "release-benchmarks",
      "configurePreset": "release-benchmarks",
      "jobs": 0,
      "targets": [
        "benchmarks"
      ]
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "jobs": 0
    }
  ],

  "testPresets": [
    {
      "name": "debug-tests",
      "configurePreset": "debug-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
